    <style>
        .hero-slider {
            position: absolute;
            right: 0;
            bottom: 0;
            width: 59%;
            min-height: 540px;
            overflow: hidden;
            border-radius: 0px;
        }

        .hero-slide {
            position: absolute;
            inset: 0;
            background-position: center;
            background-size: cover;
            opacity: 0;
            transition: opacity 700ms ease-in-out;
        }

        .hero-slide::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(90deg, rgba(35, 16, 24, .5), transparent 75%);
        }

        .hero-slide.active {
            opacity: 1;
        }

        .hero-ad {
            position: absolute;
            z-index: 1;
            left: 8%;
            right: auto;
            bottom: 122px;
            max-width: 290px;
            color: #fff;
        }

        .hero-ad-badge {
            display: inline-block;
            margin-bottom: 10px;
            padding: 6px 10px;
            border-radius: 999px;
            background: #f5b5f6;
            color: #3a1830;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .hero-ad h2 {
            margin: 0 0 8px;
            font-family: "Playfair Display", serif;
            font-size: 30px;
            line-height: 1.1;
        }

        .hero-ad p {
            margin: 0 0 16px;
            font-size: 14px;
            line-height: 1.45;
        }

        .hero-ad-link {
            display: inline-block;
            padding: 10px 15px;
            border-radius: 8px;
            background: #fff;
            color: #cf2c68;
            font-size: 13px;
            font-weight: 700;
        }

        .slider-controls {
            position: absolute;
            z-index: 2;
            right: 20px;
            bottom: 18px;
            display: flex;
            gap: 8px;
        }

        .slider-dot {
            width: 10px;
            height: 10px;
            padding: 0;
            border: 0;
            border-radius: 50%;
            background: rgba(255, 255, 255, .55);
            cursor: pointer;
        }

        .slider-dot.active {
            width: 28px;
            border-radius: 8px;
            background: #fff;
        }

        @media (prefers-reduced-motion: reduce) {
            .hero-slide { transition: none; }
        }
        .cls-1 {
        fill: #d92a5e;
